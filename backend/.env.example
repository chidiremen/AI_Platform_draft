# Copy to .env and adjust for your environment.

# Django secret key (generate a strong value for non-dev environments)
SECRET_KEY=dev-insecure-change-me

# Debug toggle
DEBUG=True

# Comma-separated allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated CORS / CSRF origins (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:8009,http://127.0.0.1:8009
CSRF_TRUSTED_ORIGINS=http://localhost:8009,http://127.0.0.1:8009

# Microsoft Teams incoming webhook for access-request notifications (optional)
TEAMS_WEBHOOK_URL=
