# Copy to .env and adjust for your environment.
#
# ⚠️ ポート番号（FRONTEND_PORT / BACKEND_PORT）はプロジェクトルート `../.env`
#    で一括管理してください。個別の backend/.env はそちらの上書き用途に。

# Django secret key (generate a strong value for non-dev environments)
SECRET_KEY=dev-insecure-change-me

# Debug toggle
DEBUG=True

# Comma-separated allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS / CSRF は未設定なら FRONTEND_PORT から自動生成されます。
# 明示的に上書きしたい場合のみ設定してください。
# CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Microsoft Teams incoming webhook for access-request notifications (optional)
TEAMS_WEBHOOK_URL=
