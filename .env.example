# =============================================================================
#  AI Tool Catalog — 開発環境共通設定
#  このファイルを .env にコピーし、必要に応じて編集してください。
#  frontend (Vite) / backend (Django) 双方がこのファイルを読み込みます。
#
#  【保存形式】UTF-8 で保存してください（BOM有無・改行コードは不問）。
#  Shift-JIS でも動作しますが日本語コメントが化けます。UTF-16（メモ帳の
#  「Unicode」）だけは cmd.exe が読めず、start.bat がポートを既定値に
#  戻して警告を出します。
# =============================================================================

# ---- ポート設定（変更するとフロント/バック両方が自動追従します）----
FRONTEND_PORT=5174
BACKEND_PORT=8009

# ---- フロントエンド (Vite) ----
# false = Django バックエンドに接続（実運用はこちら。既定）
# true  = モックモード。バックエンド不要でデモ動作するが、ログインは
#         ソースに埋め込まれたデモユーザーとの照合になり、DB のユーザーでは
#         ログインできない。DB をコピーしてきた環境で true になっていると
#         「データが空に見える／ログインできない」の原因になるので注意。
VITE_USE_MOCK=false
# API ベースURL（未設定なら http://localhost:${BACKEND_PORT}/api を自動生成）
# VITE_API_BASE=http://localhost:8009/api

# ---- バックエンド (Django) ----
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# CORS / CSRF は未設定なら FRONTEND_PORT から自動生成されます。
# CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# テーマがこの日数だけ進捗更新されないと一覧で「停滞」と表示する。
# 表示上の判定だけなので、変更しても既存データには影響しません。
THEME_STALLED_AFTER_DAYS=30

# Microsoft Teams incoming webhook（申請通知・任意）
TEAMS_WEBHOOK_URL=
