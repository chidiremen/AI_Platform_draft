# =============================================================================
#  AI Tool Catalog — 開発環境共通設定
#  このファイルを .env にコピーし、必要に応じて編集してください。
#  frontend (Vite) / backend (Django) 双方がこのファイルを読み込みます。
# =============================================================================

# ---- ポート設定（変更するとフロント/バック両方が自動追従します）----
FRONTEND_PORT=5174
BACKEND_PORT=8009

# ---- フロントエンド (Vite) ----
# true（既定）= モックモード（バックエンド不要でデモ動作）
# false = Django バックエンドに接続
VITE_USE_MOCK=true
# API ベースURL（未設定なら http://localhost:${BACKEND_PORT}/api を自動生成）
# VITE_API_BASE=http://localhost:8009/api

# ---- バックエンド (Django) ----
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# CORS / CSRF は未設定なら FRONTEND_PORT から自動生成されます。
# CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Microsoft Teams incoming webhook（申請通知・任意）
TEAMS_WEBHOOK_URL=
