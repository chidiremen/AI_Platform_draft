# =============================================================================
#  AI Tool Catalog — 開発環境共通設定
#  このファイルを .env にコピーし、必要に応じて編集してください。
#  frontend (Vite) / backend (Django) 双方がこのファイルを読み込みます。
#
#  【保存形式】UTF-8 で保存してください（BOM有無・改行コードは不問）。
#  Shift-JIS でも動作しますが日本語コメントが化けます。UTF-16（メモ帳の
#  「Unicode」）だけは cmd.exe が読めず、start.bat がポートを既定値に
#  戻して警告を出します。
# =============================================================================

# ---- ポート設定（変更するとフロント/バック両方が自動追従します）----
FRONTEND_PORT=5174
BACKEND_PORT=8009

# ---- フロントエンド (Vite) ----
# false（既定）= Django バックエンドに接続。実運用はこちら。
# true  = モックモード。バックエンド不要でデモ動作するが、ログインは
#         ソースに埋め込まれたデモユーザーとの照合になり、DB のユーザーでは
#         ログインできない。モックで動いている間は画面上部に警告が出る。
#
# ※ この設定を変えても挙動が変わらない場合、frontend/vite.config.js が
#    残っていないか確認してください。あると vite.config.ts が無視され、
#    このファイル自体が読まれなくなります（doctor.bat で検知できます）。
VITE_USE_MOCK=false
# API ベースURL（未設定なら http://localhost:${BACKEND_PORT}/api を自動生成）
# VITE_API_BASE=http://localhost:8009/api

# ---- バックエンド (Django) ----
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# CORS / CSRF は未設定なら FRONTEND_PORT から自動生成されます。
# CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# テーマがこの日数だけ進捗更新されないと一覧で「停滞」と表示する。
# 表示上の判定だけなので、変更しても既存データには影響しません。
THEME_STALLED_AFTER_DAYS=30

# ---- 通知（Power Automate 連携）----
# Power Automate の「HTTP 要求の受信時」トリガーが発行する URL。
# 全イベントをこの1本に投げ、フロー側の Switch で振り分けます。
# URL に SAS 署名が含まれるため、実質的な認証情報として扱ってください。
POWER_AUTOMATE_WEBHOOK_URL=

# 通知に載せるリンクのベースURL（未設定なら http://localhost:${FRONTEND_PORT}）
# 社内配布時は実際のホスト名を入れてください。
FRONTEND_BASE_URL=

# 送るイベントを限定する（空なら全イベント）
# 例: NOTIFY_EVENTS=tool.created,access_request.created,theme.frozen
NOTIFY_EVENTS=

# 宛先が特定できないイベント（ツール登録の周知など）の既定宛先
NOTIFY_DEFAULT_EMAILS=

# フロー側で想定外の送信元を弾くための合言葉（X-AITC-Token ヘッダで送る）
NOTIFY_SHARED_TOKEN=

# ---- 旧: Teams Incoming Webhook（申請通知・任意）----
# Microsoft がこの種のコネクタを廃止する方針のため、新規は上の
# POWER_AUTOMATE_WEBHOOK_URL を使ってください。両方設定されている場合、
# 二重通知を避けるため Power Automate 側だけが動きます。
TEAMS_WEBHOOK_URL=
