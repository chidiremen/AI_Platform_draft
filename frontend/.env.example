# フロントエンドの実行モード設定（Vite）
#
# 既定（このファイルをコピーしない / 変数未設定）では「モックモード」で動作し、
# バックエンド無しで全機能のデモが可能です。
#
# 実APIモード（Django + DRF バックエンドに接続）にするには、
# このファイルを .env.local にコピーして以下を設定してください。

# 実APIに接続する場合は false を設定（既定は true=モック）
VITE_USE_MOCK=false

# バックエンドAPIのベースURL（末尾スラッシュ不要・既定 http://localhost:5174/api）
VITE_API_BASE=http://localhost:5174/api
