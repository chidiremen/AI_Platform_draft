# フロントエンドの実行モード設定（Vite）
#
# ⚠️ ポート番号（FRONTEND_PORT / BACKEND_PORT）はプロジェクトルート `../.env`
#    で一括管理してください。個別の `.env.local` はそちらの上書き用途に。
#
# 既定（未設定）では「モックモード」で動作し、バックエンド無しで全機能を
# デモできます。実 API モードにするには以下を設定してください。

# 実APIモードに切替（既定は true=モック）
VITE_USE_MOCK=false

# API 接続先を明示指定する場合のみ設定（未設定なら BACKEND_PORT から自動生成）
# VITE_API_BASE=http://localhost:8009/api
