{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // tsc -b の副産物 (vite.config.js/.d.ts) が frontend/ 直下に落ちると、
    // Vite が .ts より .js を優先し古いポート等の設定を拾ってしまう。
    // 出力先を専用ディレクトリに分離する（Vite の探索対象外にする）。
    "outDir": "./.tsc-node"
  },
  "include": ["vite.config.ts"]
}
